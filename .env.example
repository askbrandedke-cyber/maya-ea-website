# Copy to .env.local (never commit .env.local). On Vercel: Project → Settings → Environment Variables.

# Public site URL, used for canonical URLs, sitemap and the QR codes on the packs
NEXT_PUBLIC_SITE_URL=https://www.mayaealtd.com

# Search indexing. Keep false for the proposal build; set true only when Maya approves go-live.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Email sending (https://resend.com). Leave RESEND_API_KEY empty to run forms in DRY-RUN mode
# (enquiries are validated and logged to the server console, nothing is emailed).
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Maya website <website@mayaealtd.com>"
ENQUIRY_FROM=

# Inbox per country (comma-separate several). Empty → ENQUIRY_TO_DEFAULT.
ENQUIRY_TO_KE=
ENQUIRY_TO_UG=
ENQUIRY_TO_RW=
ENQUIRY_TO_DEFAULT=
